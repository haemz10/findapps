{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "Bash(node scripts/*)",
      "Bash(npm install)",
      "Bash(npm run *)",
      "Bash(npx playwright install *)",
      "Bash(mkdir *)",
      "Bash(ls *)",
      "Bash(cp *)"
    ],
    "deny": []
  }
}
