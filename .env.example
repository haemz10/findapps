# ── AI 콘텐츠 생성 (Claude API) ──────────────────────────────
# https://console.anthropic.com/ 에서 발급
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
# 사용할 모델 (기본값: claude-sonnet-5)
ANTHROPIC_MODEL=claude-sonnet-5

# ── 발행 대상 플랫폼: tistory | naver ────────────────────────
PLATFORM=tistory

# ── Tistory ─────────────────────────────────────────────────
# 블로그 주소 (예: myblog.tistory.com)
TISTORY_BLOG=myblog.tistory.com
# 카카오 로그인 계정 (최초 1회 `npm run login`으로 세션 저장 권장)
TISTORY_ID=
TISTORY_PW=

# ── Naver ───────────────────────────────────────────────────
NAVER_ID=
NAVER_PW=

# ── 실행 옵션 ────────────────────────────────────────────────
# 브라우저 창을 보이게 실행할지 (true 권장: 최초 로그인/캡차 대응)
HEADLESS=false
